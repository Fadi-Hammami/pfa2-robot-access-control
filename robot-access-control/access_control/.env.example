# Copier ce fichier en ".env" puis remplir les valeurs.
# Le fichier .env est ignoré par git : ne JAMAIS le publier.

# Compte Gmail qui envoie les alertes et lit les réponses de l'administrateur
EMAIL_SENDER=votre.adresse@gmail.com

# Mot de passe d'application Gmail (16 caractères), PAS le mot de passe du compte.
# Compte Google > Sécurité > Validation en 2 étapes > Mots de passe des applications
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Adresse qui reçoit les alertes (peut être la même que l'expéditeur)
EMAIL_RECIPIENT=admin@exemple.com
